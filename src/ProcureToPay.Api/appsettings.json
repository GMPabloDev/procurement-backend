{
  "AWS": {
    "Region": "us-east-1"
  },
  "OpenTelemetry": {
    "ServiceName": "ProcureToPay.Api"
  },
  "Storage": {
    "S3": {
      "BucketName": "",
      "MaxUploadSizeBytes": 10485760,
      "AllowedExtensions": [
        ".pdf",
        ".png",
        ".jpg",
        ".jpeg"
      ],
      "TemporaryUrlLifetimeMinutes": 15
    }
  },
  "Authentication": {
    "JwtBearer": {
      "Authority": "",
      "Audience": "",
      "RequireHttpsMetadata": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Approval": {
    "Workloads": [
      {
        "Issuer": "internal://procure-to-pay",
        "ClientId": "purchase-order-domain"
      }
    ]
  },
  "Budget": {
    "MovementProducers": [
      {
        "Operation": "COMMIT",
        "ContractVersion": "v1",
        "SourceType": "PURCHASE_ORDER",
        "ProducerId": "purchase-order-domain",
        "Issuer": "internal://procure-to-pay",
        "ClientId": "purchase-order-domain"
      },
      {
        "Operation": "REVERSE",
        "ContractVersion": "v1",
        "SourceType": "PURCHASE_ORDER",
        "ProducerId": "purchase-order-domain",
        "Issuer": "internal://procure-to-pay",
        "ClientId": "purchase-order-domain"
      },
      {
        "Operation": "REVERSE",
        "ContractVersion": "v1",
        "SourceType": "PURCHASE_REQUEST",
        "ProducerId": "purchase-order-domain",
        "Issuer": "internal://procure-to-pay",
        "ClientId": "purchase-order-domain"
      }
    ]
  }
}
