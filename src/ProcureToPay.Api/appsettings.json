{
  "AWS": {
    "Region": "us-east-1"
  },
  "OpenTelemetry": {
    "ServiceName": "ProcureToPay.Api"
  },
  "Storage": {
    "S3": {
      "BucketName": "",
      "MaxUploadSizeBytes": 10485760,
      "AllowedExtensions": [
        ".pdf",
        ".png",
        ".jpg",
        ".jpeg"
      ],
      "TemporaryUrlLifetimeMinutes": 15
    }
  },
  "Authentication": {
    "JwtBearer": {
      "Authority": "",
      "Audience": "",
      "RequireHttpsMetadata": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
